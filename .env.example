# Supabase (mobile app uses publishable key only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Naver Cloud Platform - Maps SDK Client ID
# Register at https://console.ncloud.com (Korean address required)
# Phase 1 Task 13에서 필요. 그 전까지 placeholder 유지 가능
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_client_id_here

# Spring Boot API server
EXPO_PUBLIC_API_URL=http://localhost:8080

# Sentry — error tracking (Task 31)
# Leave blank in dev: src/shared/lib/sentry.ts skips Sentry.init when DSN is empty.
# Get the DSN from Sentry → app project → Settings → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=

# Sentry sourcemap upload (build-time only, never bundled into the app).
# Auth Tokens → User → Account → Auth Tokens with scope project:releases.
# Used by sentry-expo-upload-sourcemaps; absent in CI/dev = upload silently skipped.
SENTRY_AUTH_TOKEN=
