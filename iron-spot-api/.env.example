DATABASE_URL=jdbc:postgresql://localhost:5433/ironspot
DATABASE_USERNAME=ironspot
DATABASE_PASSWORD=ironspot
# JWKS endpoint for Supabase Auth JWT verification (ES256 / asymmetric).
# Supabase auto-migrated all projects from legacy HS256 shared secrets to ECC P-256
# signing keys; tokens from new sessions must be verified against the JWKS document.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_VISION_API_KEY=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Groq LLM API key — primary NL Search LLM (Task 35).
# Get from console.groq.com → API Keys. Free tier, no credit card required.
GROQ_API_KEY=

# Google Gemini API key — fallback NL Search LLM (Task 35).
# Get from aistudio.google.com → Get API key. Free tier, no billing activation.
GEMINI_API_KEY=

# Sentry — error tracking (Task 31)
# Empty → SentryConfig skips Sentry.init. Get from Sentry → API project → Settings → Client Keys.
SENTRY_DSN=

# Slack admin moderation channel webhook (Task 27 carry-over).
# Workspace → Apps → Incoming Webhooks → add to #ironspot-moderation → copy URL.
# Empty → AdminNotificationService log-only no-op.
SLACK_ADMIN_WEBHOOK_URL=

# Slack smoke endpoint gate (/api/_admin/slack-smoke/{path}).
# MUST be `false` outside the post-deploy smoke window. Toggle to `true` on Railway only for the
# 5-minute window when running the 3-path verification curl, then immediately untoggle.
IRONSPOT_SLACK_SMOKE_ENABLED=false

# Sentry server-side smoke endpoint gate (/api/_admin/sentry-smoke) — Task 32 decision #3.
# MUST be `false` outside the Task 32b verify window. Endpoint throws a RuntimeException which
# GlobalExceptionHandler routes through Sentry.captureException so the event arrives in the
# Sentry ironspot-api project. Toggle on, run one curl, confirm event in dashboard, toggle off.
IRONSPOT_SENTRY_SMOKE_ENABLED=false
