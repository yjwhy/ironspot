{
  "name": "iron-spot",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "dev:local": "rm -f .env.local && expo start --dev-client --clear",
    "dev:prod": "printf 'EXPO_PUBLIC_API_URL=https://ironspot.onrender.com\\n' > .env.local && expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "snap": "./scripts/snap.sh",
    "e2e:smoke": "maestro test .maestro/flows/smoke.yaml",
    "e2e:flow": "maestro test",
    "e2e:all": "maestro test .maestro",
    "prepare": "husky",
    "generate:api": "orval --config orval.config.ts && prettier --write \"src/shared/generated/**/*.ts\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@mj-studio/react-native-naver-map": "^2.9.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.5.1",
    "@sentry/react-native": "8.28.1",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.107.1",
    "burnt": "^0.13.0",
    "dayjs": "^1.11.13",
    "expo": "~58.0.25",
    "expo-build-properties": "^58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.31",
    "expo-secure-store": "^58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "ky": "^2.0.2",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.75.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.35.9",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "lint-staged": "^17.0.5",
    "orval": "^8.48.0",
    "prettier": "^3.9.8",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "zod-validation-error": "^4.0.1"
    }
  }
}
